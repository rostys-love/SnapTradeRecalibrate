# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Never commit .env.local.

# SnapTrade Personal API key: https://dashboard.snaptrade.com/api-key
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Optional built-in login. Leave BOTH unset when the site is protected by Vercel Authentication
# (Project → Settings → Deployment Protection → Vercel Authentication, scope "All Deployments").
# Set them to use the app's own password page instead. Secret: openssl rand -base64 48
SITE_PASSWORD=
SESSION_SECRET=

# Optional: live quotes for rebuilt managed holdings (https://finnhub.io)
FINNHUB_API_KEY=

# Optional: your deployed URL (e.g. https://port-calibrate.vercel.app). Detected automatically if unset.
APP_URL=
